# OLA Health OS Environment Variables
# Copy this file to .env and configure your local settings if needed

SECRET_KEY=change-this-in-production-to-a-secure-random-key
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1

# Optional MySQL Database Connection Settings
# If not provided, OLA Health OS automatically runs in safe SQLite demonstration mode
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ola_health_os
